#N canvas 40 40 1100 700 12;
#X text 20 2 orch_hit: a C major stab of detuned saws + noise \, filter closing as it decays. Godot sends orch_hit <velocity>;
#X obj 20 40 r orch_hit;
#X obj 20 70 / 127;
#X obj 20 100 t f b b;
#X obj 300 40 r orch_tune;
#X obj 420 40 r orch_detune;
