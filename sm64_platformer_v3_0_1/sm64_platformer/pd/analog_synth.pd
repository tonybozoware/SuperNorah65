#N canvas 40 40 900 700 12;
#X text 20 2 analog_synth: 6-voice subtractive synth. Godot sends synth_note [note velocity] (velocity 0 = off);
#X obj 20 40 r synth_note;
#X obj 20 80 poly 6 1;
#X obj 20 120 pack f f f;
#X obj 20 160 clone -s 1 analog_voice 6;
#X obj 20 200 *~ 0.8;
#X obj 150 170 r synth_volume;
#X obj 20 240 throw~ analog_out;
#X obj 220 40 r synth_all_off;
#X msg 220 80 stop;
#X obj 420 40 loadbang;
#X msg 420 80  \; synth_osc1_level 1 \; synth_osc2_level 0.8 \; synth_sub_level 0.4 \; synth_detune 7 \; synth_cutoff 700 \; synth_resonance 0.35 \; synth_filter_env_amount 2500 \; synth_filter_velocity 0.5 \; synth_filter_attack 5 \; synth_filter_decay 350 \; synth_filter_sustain 0.25 \; synth_filter_release 300 \; synth_attack 5 \; synth_decay 300 \; synth_sustain 0.7 \; synth_release 300 \; synth_volume 0.8 \; synth_pulse_width 0.5 \; synth_pulse_mix 0 \; synth_drive 0 \; synth_plaits_level 0 \; synth_plaits_model 8 \; synth_plaits_harmonics 0.5 \; synth_plaits_timbre 0.5 \; synth_plaits_morph 0.5 \; synth_plaits_decay 0.5 \; synth_plaits_colour 0.5 \; synth_plaits_triggered 0;
#X connect 1 0 2 0;
#X connect 2 0 3 0;
#X connect 2 1 3 1;
#X connect 2 2 3 2;
#X connect 3 0 4 0;
#X connect 4 0 5 0;
#X connect 6 0 5 1;
#X connect 5 0 7 0;
#X connect 8 0 9 0;
#X connect 9 0 2 0;
#X connect 10 0 11 0;
