#N canvas 40 40 1400 800 12;
#X text 20 2 instruments: the mixer. Each instrument: level and delay send. Send -> clouds~ tape echo -> clouds~ grains -> return;
#X obj 20 400 catch~ mix_dry;
#X obj 400 400 catch~ mix_send;
#X obj 20 40 catch~ analog_out;
#X obj 110 70 r mix_analog_level;
#X msg 110 100 \$1 20;
#X obj 110 130 line~;
#X obj 20 160 *~;
#X obj 20 190 throw~ mix_dry;
#X obj 110 220 r mix_analog_send;
#X msg 110 250 \$1 20;
#X obj 110 280 line~;
#X obj 20 310 *~;
#X obj 20 340 throw~ mix_send;
