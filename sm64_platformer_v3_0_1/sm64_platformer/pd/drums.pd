#N canvas 40 40 900 700 12;
#X text 20 2 drums: kick / snare / hat. Godot sends drum_kick \, drum_snare \, drum_hat with a velocity 0-127;
#X obj 20 40 r drum_kick;
#X obj 20 70 / 127;
#X obj 20 100 t f b b;
#X msg 160 130 0;
#X obj 100 160 f 150;
#X obj 100 190 pack f f f;
#X msg 100 220 \$1 \, \$2 \$3;
#X obj 100 250 vline~;
#X obj 100 280 osc~;
#X obj 260 160 r kick_pitch;
#X obj 260 190 r kick_end;
#X obj 260 220 r kick_pitch_decay;
#X obj 20 310 pack f f;
#X msg 20 340 \$1 \, 0 \$2;
#X obj 20 370 vline~;
#X obj 20 400 *~;
#X obj 120 310 r kick_decay;
#X obj 100 430 *~;
#X obj 100 460 *~ 1.5;
#X obj 200 430 r kick_drive;
#X obj 100 490 expr~ tanh(\$v1);
#X obj 100 520 *~ 1;
#X obj 200 490 r kick_level;
#X obj 380 40 r drum_snare;
#X obj 380 70 / 127;
#X obj 380 100 t f b;
#X msg 480 130 0;
#X obj 380 160 pack f f;
#X msg 380 190 \$1 \, 0 \$2;
#X obj 380 220 vline~;
#X obj 480 160 r snare_decay;
#X obj 380 250 *~;
#X obj 560 220 osc~ 190;
#X obj 560 190 r snare_tone;
#X obj 680 220 noise~;
#X obj 680 250 hip~ 900;
#X obj 780 220 r snare_snappy_tone;
#X obj 560 280 *~ 0.5;
#X obj 680 280 *~ 0.6;
#X obj 780 280 r snare_noise;
#X obj 560 250 expr 1 - \$f1;
#X obj 560 320 *~;
#X obj 560 350 *~ 1;
#X obj 660 350 r snare_level;
#X obj 380 420 r drum_hat;
#X obj 380 450 / 127;
#X obj 380 480 pack f f;
#X msg 380 510 \$1 \, 0 \$2;
#X obj 380 540 vline~;
#X obj 480 480 r hat_decay;
#X obj 380 570 *~;
#X obj 560 450 noise~;
#X obj 560 480 hip~ 7000;
#X obj 560 510 hip~ 7000;
#X obj 680 450 r hat_tone;
#X obj 560 570 *~;
#X obj 560 600 *~ 0.6;
#X obj 660 600 r hat_level;
#X obj 100 600 *~ 0.8;
#X obj 200 570 r drums_volume;
#X obj 100 640 throw~ drums_out;
#X obj 800 40 loadbang;
#X msg 800 80  \; kick_pitch 150 \; kick_end 48 \; kick_pitch_decay 60 \; kick_decay 380 \; kick_drive 1.5 \; kick_level 1 \; snare_tone 190 \; snare_noise 0.6 \; snare_snappy_tone 900 \; snare_decay 180 \; snare_level 0.8 \; hat_decay 60 \; hat_tone 7000 \; hat_level 0.5 \; drums_volume 0.8;
