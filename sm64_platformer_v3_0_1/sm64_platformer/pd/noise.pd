#N canvas 40 40 900 700 12;
#X text 20 2 noise: a filtered noise burst. Godot sends noise_hit <velocity>;
#X obj 20 40 r noise_hit;
#X obj 20 70 / 127;
#X obj 20 100 t f f;
#X obj 20 140 pack f f f;
#X obj 120 110 r noise_attack;
#X obj 220 110 r noise_decay;
#X msg 20 170 \$1 \$2 \, 0 \$3 \$2;
#X obj 20 200 vline~;
#X obj 20 240 *~;
#X obj 380 40 r noise_tone;
#X obj 500 40 r noise_sweep;
#X obj 380 110 f 2500;
#X obj 500 110 f 0.5;
#X obj 620 110 f 60;
#X obj 380 75 t b b b;
#X obj 380 140 pack f f f;
#X obj 380 200 expr \$f1*(1+\$f2*4) \; \$f1 \; \$f3;
#X obj 380 230 pack f f f;
#X msg 380 260 \$1 \, \$2 \$3;
#X obj 380 290 vline~;
#X obj 200 290 noise~;
#X obj 200 330 vcf~ 2;
#X obj 300 300 r noise_q;
#X obj 420 330 r noise_band;
#X obj 420 360 expr 1 - \$f1;
#X obj 200 370 *~ 0.7;
#X obj 300 370 *~ 0.3;
#X obj 200 400 *~ 3;
#X obj 200 440 *~;
#X obj 200 470 *~ 0.8;
#X obj 300 470 r noise_level;
#X obj 200 510 throw~ noise_out;
#X obj 700 40 loadbang;
#X msg 700 70  \; noise_attack 1 \; noise_decay 60 \; noise_tone 2500 \; noise_sweep 0.5 \; noise_q 2 \; noise_band 0.7 \; noise_level 0.45;
