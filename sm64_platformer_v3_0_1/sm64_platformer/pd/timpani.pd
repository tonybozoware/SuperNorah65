#N canvas 40 40 1100 700 12;
#X text 20 2 timpani: drum partials with a pitch drop on the strike \, plus a felt mallet thump. Godot sends timpani_hit <velocity>;
#X obj 20 40 r timpani_hit;
#X obj 20 70 / 127;
#X obj 20 100 t f f b;
#X obj 200 40 r timpani_tune;
