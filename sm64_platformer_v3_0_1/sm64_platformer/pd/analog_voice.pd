#N canvas 40 40 900 700 12;
#X text 20 2 one voice of analog_synth: 2 saw/pulse oscs + sub square + Plaits > drive > Moog ladder filter > amp;
#X obj 20 30 inlet;
#X obj 20 60 unpack f f;
#X obj 20 100 mtof;
#X obj 20 130 t f f f;
#X obj 20 200 phasor~;
#X obj 110 170 * 1;
#X obj 110 200 phasor~;
#X obj 200 170 * 0.5;
#X obj 200 200 phasor~;
#X obj 300 100 r synth_detune;
#X obj 300 130 expr pow(2 \, \$f1/1200);
#X obj 20 240 expr~ (\$v1*2-1)*(1-\$f3) + 2*((\$v1<\$f2)-\$f2)*\$f3;
#X obj 110 240 expr~ (\$v1*2-1)*(1-\$f3) + 2*((\$v1<\$f2)-\$f2)*\$f3;
#X obj 200 240 expr~ (\$v1>0.5)*2-1;
#X obj 300 200 r synth_pulse_width;
#X obj 300 225 clip 0.02 0.98;
#X obj 420 200 r synth_pulse_mix;
#X obj 20 280 *~ 1;
#X obj 110 280 *~ 1;
#X obj 200 280 *~ 0;
#X obj 20 320 r synth_osc1_level;
#X obj 170 320 r synth_osc2_level;
#X obj 330 320 r synth_sub_level;
#X msg 560 20 note \$1;
#X obj 560 300 plaits~;
#X obj 560 330 *~ 0;
#X obj 700 230 r synth_plaits_level;
#X obj 700 260 * 3;
#X obj 820 260 > 0;
#X msg 820 290 active \$1;
#X obj 900 20 r synth_plaits_model;
#X msg 900 50 model \$1;
#X obj 900 80 r synth_plaits_harmonics;
#X msg 900 110 harmonics \$1;
#X obj 900 140 r synth_plaits_timbre;
#X msg 900 170 timbre \$1;
#X obj 1080 20 r synth_plaits_morph;
#X msg 1080 50 morph \$1;
#X obj 1080 80 r synth_plaits_decay;
#X msg 1080 110 decay \$1;
#X obj 1080 140 r synth_plaits_colour;
#X msg 1080 170 colour \$1;
#X obj 1080 200 r synth_plaits_triggered;
#X msg 1080 230 triggered \$1;
#X obj 560 90 t b;
#X msg 560 120 trig;
#X obj 20 360 *~ 0.35;
#X obj 450 60 moses 1;
#X obj 520 90 / 127;
#X obj 520 120 t f f f;
#X obj 600 150 * 0.7;
#X obj 520 180 pack f f f f;
#X msg 520 210 \$1 \$2 \, \$3 \$4 \$2;
#X obj 520 240 vline~;
#X obj 700 120 r synth_attack;
#X obj 700 150 r synth_decay;
#X obj 700 180 r synth_sustain;
#X obj 450 250 t b;
#X obj 450 280 f 300;
#X msg 450 310 0 \$1;
#X obj 560 280 r synth_release;
#X obj 760 240 expr 1 - \$f2 + \$f2*\$f1;
#X obj 900 210 r synth_filter_velocity;
#X obj 760 270 t f f;
#X obj 840 300 * 0.3;
#X obj 760 330 pack f f f f;
#X msg 760 360 \$1 \$2 \, \$3 \$4 \$2;
#X obj 760 390 vline~;
#X obj 940 270 r synth_filter_attack;
#X obj 940 300 r synth_filter_decay;
#X obj 940 330 r synth_filter_sustain;
#X obj 620 420 f 300;
#X msg 620 450 0 \$1;
#X obj 700 420 r synth_filter_release;
#X obj 760 430 *~ 2000;
#X obj 860 460 r synth_filter_env_amount;
#X obj 760 470 +~ 800;
#X obj 860 500 r synth_cutoff;
#X obj 760 510 clip~ 20 18000;
#X obj 300 400 r synth_resonance;
#X obj 300 430 * 3.8;
#X obj 300 460 sig~ 1;
#X obj 300 480 r synth_drive;
#X obj 300 505 expr 1 + \$f1*7;
#X obj 300 530 t f f;
#X obj 420 555 expr 0.6/tanh(0.6*\$f1);
#X obj 20 490 expr~ tanh(\$v1*\$f2)*\$f3;
#X obj 20 520 bob~;
#X obj 20 560 *~;
#X obj 20 600 outlet~;
