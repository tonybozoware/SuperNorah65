#N canvas 40 40 900 700 12;
#X text 20 2 sampler: 8 sample slots (arrays smp0-smp7 \, filled by Godot) \, 6 voices. Godot sends sampler_play [frames ms velocity slot];
#X obj 560 30 array define smp0 1;
#X obj 560 60 array define smp1 1;
#X obj 560 90 array define smp2 1;
#X obj 560 120 array define smp3 1;
#X obj 560 150 array define smp4 1;
#X obj 560 180 array define smp5 1;
#X obj 560 210 array define smp6 1;
#X obj 560 240 array define smp7 1;
#X obj 20 40 r sampler_play;
#X obj 160 70 f 0;
#X obj 200 100 + 1;
#X obj 160 100 mod 6;
#X obj 20 70 t l b;
#X obj 20 140 list prepend;
#X obj 20 170 list trim;
#X obj 20 210 clone -s 0 sampler_voice 6;
#X obj 20 250 *~ 1;
#X obj 120 250 r sampler_level;
#X obj 20 290 throw~ sampler_out;
#X connect 9 0 13 0;
#X connect 13 1 10 0;
#X connect 10 0 11 0;
#X connect 11 0 12 0;
#X connect 12 0 10 1;
#X connect 10 0 14 1;
#X connect 13 0 14 0;
#X connect 14 0 15 0;
#X connect 15 0 16 0;
#X connect 16 0 17 0;
#X connect 18 0 17 1;
#X connect 17 0 19 0;
