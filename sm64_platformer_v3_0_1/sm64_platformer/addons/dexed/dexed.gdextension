[libraries]

windows.debug.x86_64 = "res://addons/dexed/bin/libdexed.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/dexed/bin/libdexed.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://addons/dexed/bin/libdexed.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/dexed/bin/libdexed.linux.template_release.x86_64.so"
