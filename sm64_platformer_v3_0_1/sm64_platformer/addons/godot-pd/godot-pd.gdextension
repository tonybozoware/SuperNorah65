[configuration]

entry_symbol = "godotpd_init"
compatibility_minimum = "4.5"
reloadable = true

[libraries]

linux.debug.x86_64 = "res://addons/godot-pd/bin/libgodot-pd.linux.template_release.x86_64.so"
linux.release.x86_64 = "res://addons/godot-pd/bin/libgodot-pd.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://addons/godot-pd/bin/libgodot-pd.windows.template_release.x86_64.dll"
windows.release.x86_64 = "res://addons/godot-pd/bin/libgodot-pd.windows.template_release.x86_64.dll"

[icons]

AudioStreamPD = "res://addons/godot-pd/icons/audio_stream_pd.svg"
